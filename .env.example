# Fictional localhost environment. Never use these public development secrets for real data.
NODE_ENV=development
# Optional localhost-only shared staff preview. Sensitive actions still require MFA.
LOCAL_PREVIEW_PASSWORD_ONLY=false
# Temporary local fictional presentation: automatic member/staff sessions; never production.
LOCAL_PRESENTATION_MODE=false
DATABASE_URL=postgresql://agap_runtime:development-runtime@127.0.0.1:55432/agap
IDENTITY_DATABASE_URL=postgresql://agap_identity:development-identity@127.0.0.1:55432/agap
MIGRATION_DATABASE_URL=postgresql://agap_owner:development-owner@127.0.0.1:55432/agap
PUBLIC_ORIGIN=http://127.0.0.1:5174
API_PORT=4100
SESSION_SECRET=fictional-development-session-secret-change-before-real-use
SESSION_TTL_SECONDS=1800
PRIVACY_NOTICE_VERSION=fictional-development-v1
OIDC_ISSUER=http://127.0.0.1:58080/realms/agap
OIDC_CLIENT_ID=agap-staff
OIDC_CLIENT_SECRET=fictional-development-client

WORKER_DATABASE_URL=postgresql://agap_worker_local:development-worker@127.0.0.1:55432/agap
WORKER_ORGANIZATION_ID=20000000-0000-4000-8000-000000000001

# Evidence workflow: fictional development only; real release requires an approved record.
EVIDENCE_WORKFLOW_ENABLED=false
API_HOST=127.0.0.1
# Choose an absolute, private directory; shared by local API and worker only.
DOCUMENT_DIRECTORY=/tmp/agap-fictional-documents
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Deployment uses managed identity and private environment-specific Blob containers.
# AZURE_BLOB_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net
# AZURE_BLOB_CONTAINER=staging-evidence
# Qwen remains unavailable until actual execution and independent evaluation.
# QWEN_ENDPOINT=https://PRIVATE-INFERENCE-HOST/
# QWEN_SERVICE_TOKEN=<managed secret, 32+ characters>
# QWEN_RELEASE_FILE=/run/secrets/qwen-release.json
# QWEN_RELEASE_SHA256=<sha256>
# AGAP_RELEASE_FILE=/run/secrets/institutional-release.json
# AGAP_RELEASE_SHA256=<sha256>
# Keep fictional in staging; real mode requires a checksum-bound institutional release.
EVIDENCE_RECORD_MODE=fictional

# CL2 fictional principal-only staff review; requires evidence and non-production.
CONNECTED_LENDING_ENABLED=false
