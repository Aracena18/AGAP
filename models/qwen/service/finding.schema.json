{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maxItems": 30,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "page": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "excerpt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "fact": {
        "type": "object",
        "properties": {
          "factId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "relevance": {
            "default": "included",
            "type": "string",
            "enum": [
              "included",
              "not_applicable"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "opening",
              "income",
              "expense",
              "obligation"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "availability": {
                    "type": "string",
                    "const": "recorded"
                  },
                  "amountCentavos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "availability",
                  "amountCentavos"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "availability": {
                    "type": "string",
                    "const": "unavailable"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "availability",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sourceId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceVersion": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "statement": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "effectiveDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverageStart": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverageEnd": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "cashDates": {
            "maxItems": 366,
            "type": "array",
            "items": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "period": {
            "type": "string",
            "enum": [
              "one_time",
              "monthly",
              "weekly",
              "semi_monthly",
              "other",
              "unknown"
            ]
          },
          "basis": {
            "type": "string",
            "enum": [
              "net",
              "gross",
              "not_applicable",
              "unknown"
            ]
          },
          "deduction": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "factId",
          "relevance",
          "label",
          "category",
          "value",
          "sourceId",
          "sourceVersion",
          "statement",
          "effectiveDate",
          "coverageStart",
          "coverageEnd",
          "cashDates",
          "period",
          "basis",
          "deduction",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "page",
      "excerpt",
      "fact"
    ],
    "additionalProperties": false
  }
}
