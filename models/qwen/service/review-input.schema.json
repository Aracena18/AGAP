{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "sources": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._:-]+$"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        },
        "required": [
          "source_id",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "question",
    "sources"
  ],
  "additionalProperties": false
}
