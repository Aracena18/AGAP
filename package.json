{
  "name": "agap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "local:doctor": "node infra/scripts/local-dev.mjs doctor",
    "local:dev": "node infra/scripts/local-dev.mjs start",
    "test:local": "node --test infra/scripts/local-dev.test.mjs",
    "test:recovery": "node --test infra/scripts/restore-drill.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test:local && npm run test:recovery && npm run lint && npm run contracts:check && npm run build && npm run api:build && npm test && npm run test:platform && npm run typecheck:evaluation && npm run test:evaluation",
    "contracts:generate": "tsx packages/contracts/scripts/generate.ts && tsx models/qwen/service/generate-review-schema.ts",
    "contracts:check": "tsx packages/contracts/scripts/generate.ts --check && tsx models/qwen/service/generate-review-schema.ts --check",
    "api:dev": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/src/main.ts",
    "api:build": "tsc -p tsconfig.platform.json --noEmit && esbuild --tsconfig=tsconfig.platform.json apps/api/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-api/main.js",
    "api:start": "node --env-file=.env dist-api/main.js",
    "db:migrate": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/migrate.ts",
    "db:seed": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/seed.ts",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "typecheck:platform": "tsc -p tsconfig.platform.json --noEmit",
    "test:evaluation": "vitest run --config evaluation/synthetic/vitest.config.ts",
    "typecheck:evaluation": "tsc -p evaluation/synthetic/tsconfig.json --noEmit",
    "test:db": "docker compose -f infra/compose.test.yml up -d --wait",
    "worker:dev": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/worker/src/main.ts",
    "ops:drill": "node infra/scripts/restore-drill.mjs",
    "staff:provision": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/provision-staff.ts",
    "test:keycloak": "node --env-file=.env infra/scripts/identity-walkthrough.mjs",
    "test:keycloak:member": "node --env-file=.env infra/scripts/member-identity-walkthrough.mjs",
    "test:keycloak:preview": "node --env-file=.env infra/scripts/preview-identity-walkthrough.mjs",
    "preview:setup": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/configure-preview.ts",
    "member:provision": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/provision-member.ts",
    "policy:publish": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/publish-credit-policy.ts",
    "worker:build": "tsc -p tsconfig.platform.json --noEmit && esbuild --tsconfig=tsconfig.platform.json apps/worker/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-worker/main.js",
    "evidence:retire": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/retire-evidence.ts",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "test:build-context": "node infra/scripts/verify-build-context.mjs",
    "model:schemas": "tsx models/qwen/service/generate-review-schema.ts",
    "pilot:configure": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/src/modules/pilot/operator.ts",
    "recording:prepare": "tsx --tsconfig tsconfig.platform.json --env-file=.env apps/api/scripts/prepare-recording.ts",
    "recording:start": "node infra/scripts/recording-start.mjs",
    "recording:enroll": "node infra/scripts/recording-enroll.mjs",
    "recording:code": "node infra/scripts/recording-code.mjs",
    "recording:rehearse": "node infra/scripts/recording-walkthrough.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "helmet": "8.3.0",
    "motion": "^14.9.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "express": {
      "body-parser": "2.4.0"
    }
  }
}
